#!/usr/bin/env python3
"""Configure lock-screen Interactive Rain with passive hover and no clock; never lock or restart."""

import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET


PLUGIN = "online.knowmad.shaderwallpaper"


def check_path(path):
    if not path.is_absolute() or ".." in path.parts:
        raise ValueError(f"expected an absolute path without '..': {path}")
    for part in (path, *path.parents):
        if part.is_symlink():
            raise ValueError(f"refusing symlink: {part}")
        if part != path and part.exists() and not part.is_dir():
            raise ValueError(f"not a directory: {part}")


def read_config(path, groups, key, default=""):
    command = ["kreadconfig6", "--file", str(path)]
    for group in groups:
        command.extend(("--group", group))
    return subprocess.check_output([*command, "--key", key, "--default", default], text=True).rstrip("\n")


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    if os.geteuid() == 0:
        raise ValueError("run apply-lockscreen as the desktop user, without sudo")
    for tool in ("kreadconfig6", "kwriteconfig6", "ldd"):
        if not shutil.which(tool):
            raise ValueError(f"required command not found: {tool}")
    home = Path(os.environ["HOME"])
    data = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share")
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    backups = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state") / "arasaka-kde/backups"
    target = config / "kscreenlockerrc"
    for path in (target, backups):
        check_path(path)
    if target.exists() and not target.is_file():
        raise ValueError(f"not a configuration file: {target}")

    package = data / "plasma/wallpapers" / PLUGIN
    artwork = data / "wallpapers/Arasaka"
    shader = artwork / "shaders/Interactive_Rain.frag"
    texture = artwork / "mikoshi-16x9.png"
    native = package / "contents/ui/shaderwallpaper/libshaderwallpaperplugin.so"
    inputs = [shader, texture, native, package / "metadata.json", package / "contents/config/main.xml",
              package / "contents/ui/main.qml", package / "contents/ui/ShaderSystem.qml",
              native.parent / "qmldir", native.parent / "PluginStatus.qml",
              native.parent / "shaderwallpaperplugin.qmltypes"]
    for path in inputs:
        check_path(path)
        if not path.is_file() or not os.access(path, os.R_OK):
            raise ValueError(f"required installed asset missing or unreadable: {path}; install the shader wallpaper first")
    metadata = json.loads((package / "metadata.json").read_text())
    if metadata.get("KPlugin", {}).get("Id") != PLUGIN or metadata.get("KPackageStructure") != "Plasma/Wallpaper":
        raise ValueError("unexpected installed wallpaper metadata")
    with native.open("rb") as stream:
        if stream.read(4) != b"\x7fELF":
            raise ValueError("wallpaper native plugin is not an ELF library")
    if not re.search(r"\binstalled\s*:\s*true\b", (native.parent / "PluginStatus.qml").read_text()):
        raise ValueError("wallpaper native plugin reports unavailable")
    dependencies = subprocess.check_output(["ldd", str(native)], text=True)
    if "not found" in dependencies:
        raise ValueError(f"unresolved native wallpaper dependency:\n{dependencies}")
    if "// @arasaka-effect rain-v1" not in map(str.strip, shader.read_text().splitlines()):
        raise ValueError("installed Interactive Rain shader is missing the exact native-rain marker")
    # Check the generated native interface, not merely an ELF or matching filename.
    components = re.split(r"\bComponent\s*\{", (native.parent / "shaderwallpaperplugin.qmltypes").read_text())
    engine = next((part for part in components if re.search(
        r'\bname\s*:\s*"ShaderEngine"', part.split("{", 1)[0])), "")
    properties = re.findall(r"\bProperty\s*\{([^{}]*)\}", engine)
    if not any(all(re.search(pattern, prop) for pattern in (
            r'\bname\s*:\s*"rainLockScreenHost"', r'\btype\s*:\s*"bool"',
            r'\bread\s*:\s*"rainLockScreenHost"', r'\bwrite\s*:\s*"setRainLockScreenHost"'))
            and not re.search(r"\bisReadonly\s*:\s*true\b", prop) for prop in properties):
        raise ValueError("installed native renderer lacks rainLockScreenHost; rebuild/install the shader wallpaper first")

    shell = read_config(config / "plasmashellrc", ["Shell"], "ShellPackage",
                        os.environ.get("PLASMA_DEFAULT_SHELL") or "org.kde.plasma.desktop")
    if not re.fullmatch(r"[\w.-]+", shell):
        raise ValueError("unexpected Plasma shell package identifier")
    roots = [data, *map(Path, (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"))]
    shell_root = next((root / "plasma/shells" / shell for root in roots
                       if (root / "plasma/shells" / shell / "metadata.json").is_file()), None)
    clock_schema = shell_root / "contents/lockscreen/config.xml" if shell_root else None
    if clock_schema is None or not clock_schema.is_file() or not any(
            entry.get("name") == "alwaysShowClock" for entry in ET.parse(clock_schema).getroot().findall(".//{*}entry")):
        raise ValueError("active lock-screen theme does not declare alwaysShowClock")

    settings = {
        "selectedShaderPath": shader.as_uri(), "selectedShaderCode": "", "commonCode": "",
        "running": "true", "shaderSpeed": "0.75", "targetFps": "30", "resolutionScale": "1",
        "pauseMode": "3", "checkActiveScreen": "true", "excludeWindows": "",
        "mouseEnabled": "true", "audioEnabled": "false", "windowsEnabled": "false",
        "playlistEnabled": "false", "enableShaderTweaks": "false", "watchSourceFile": "false",
        "useBufferA": "false", "useBufferB": "false", "useBufferC": "false", "useBufferD": "false",
        "iChannel0Enabled": "true", "iChannel0": texture.as_uri(), "imageChannel0": "0",
        "iChannel1Enabled": "false", "iChannel2Enabled": "false", "iChannel3Enabled": "false",
        "imageChannel1": "-1", "imageChannel2": "-1", "imageChannel3": "-1",
    }
    schema_keys = {entry.get("name") for entry in ET.parse(package / "contents/config/main.xml").getroot().findall(".//{*}entry")}
    if set(settings) - schema_keys:
        raise ValueError(f"installed shader schema is missing: {sorted(set(settings) - schema_keys)}")
    groups = {"[Greeter]": {"WallpaperPlugin": PLUGIN},
              "[Greeter][LnF][General]": {"alwaysShowClock": "false"},
              f"[Greeter][Wallpaper][{PLUGIN}][General]": settings}
    original = target.read_bytes() if target.exists() else b""
    original_stat = target.stat() if target.exists() else None
    pending = {group: dict(values) for group, values in groups.items()}
    lines, group = [], ""
    # Replace only managed appearance keys; all other lines, including Daemon, stay verbatim.
    for line in original.decode("utf-8").splitlines(keepends=True):
        stripped = line.strip()
        if stripped.startswith("["):
            group = stripped
        if group in groups and stripped and not stripped.startswith(("[", "#")):
            key = stripped.split("=", 1)[0].strip()
            if key in groups[group]:
                if key not in pending[group]:
                    raise ValueError(f"duplicate managed key: {group}/{key}")
                line = f"{key}={pending[group].pop(key)}\n"
        lines.append(line)
    for group, values in pending.items():
        if values:
            lines.append("\n" + group + "\n" + "".join(f"{key}={value}\n" for key, value in values.items()))
    configured = "".join(lines).encode("utf-8")
    config.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".arasaka-lockscreen-", dir=config) as temporary:
        staged = Path(temporary) / "kscreenlockerrc"
        staged.write_bytes(configured)
        staged.chmod(stat.S_IMODE(original_stat.st_mode) if original_stat else 0o600)
        for group, values in groups.items():
            for key, expected in values.items():
                actual = read_config(staged, re.findall(r"\[([^\]]+)\]", group), key, "ARASAKA_MISSING")
                if actual != expected:
                    raise ValueError(f"KConfig readback differs: {group}/{key}: {actual!r}")
        check_path(target)
        current_stat = target.stat() if target.exists() else None
        if current_stat != original_stat or (target.read_bytes() if target.exists() else b"") != original:
            raise ValueError("lock-screen configuration changed concurrently; no settings replaced")
        backups.mkdir(parents=True, exist_ok=True)
        backup = Path(tempfile.mkdtemp(prefix=f"lockscreen-{datetime.now():%Y%m%d-%H%M%S}-", dir=backups))
        saved = backup / ("kscreenlockerrc" if original_stat else "kscreenlockerrc.missing")
        saved.write_bytes(original)
        saved.chmod(0o600)
        print(f"Lock-screen backup: {backup}", flush=True)
        # KConfig's own writer locks and merges each key with concurrent saves.
        # Prepare the shader and clock first; select the plugin only after both succeed.
        for group in reversed(groups):
            names = re.findall(r"\[([^\]]+)\]", group)
            for key, expected in groups[group].items():
                check_path(target)
                command = ["kwriteconfig6", "--file", str(target)]
                for name in names:
                    command.extend(("--group", name))
                subprocess.run([*command, "--key", key, "--", expected], check=True)
                if read_config(target, names, key, "ARASAKA_MISSING") != expected:
                    raise ValueError(f"live KConfig readback differs: {group}/{key}; backup: {backup}")
    print("Lock-screen configuration verified: Interactive Rain with passive hover, 30 FPS, 75% speed, no clock/date.")
    print("Lock policy, authentication, desktop and PLM settings are unchanged. No lock, preview or restart was performed.")
    print("The next lock-screen start will load the configuration; rendering remains unobserved.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, ET.ParseError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
