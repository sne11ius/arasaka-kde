#!/usr/bin/env python3
"""Install only the native launcher and its display-reconciliation runtime."""

import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time


PLUGIN = "com.arasaka.launcher"
PATH_UNIT = "arasaka-display-reconcile.path"
SERVICE_UNIT = "arasaka-display-reconcile.service"
PLASMA = ["qdbus6", "org.kde.plasmashell", "/PlasmaShell"]
STATUS_SCRIPT = """// arasaka-launcher-status: read live configuration, not saved applet IDs
var launcherSession = __LAUNCHER_SESSION__;
var hosts = 0, readyHosts = 0, managedPanels = 0;
desktops().forEach(function(desktop) {
    desktop.widgetIds.forEach(function(id) {
        var widget = desktop.widgetById(id);
        if (!widget || widget.type !== "com.arasaka.launcher") return;
        hosts++;
        widget.currentConfigGroup = ["Arasaka"];
        if (String(widget.readConfig("Managed", "false")) !== "true") return;
        widget.currentConfigGroup = ["General"];
        if (String(widget.readConfig("ready", "false")) === "true" &&
                String(widget.readConfig("readyToken", "")) === launcherSession) readyHosts++;
    });
});
panels().forEach(function(panel) {
    panel.currentConfigGroup = ["Arasaka"];
    if (String(panel.readConfig("Managed", "false")) === "true") managedPanels++;
});
print(JSON.stringify({hosts: hosts, ready: readyHosts === 1, managedPanels: managedPanels}));
"""


def run(*command, timeout=5, check=True):
    # Kill the entire reconciler process group on timeout, not just its shell.
    with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          text=True, start_new_session=True) as process:
        try:
            stdout, stderr = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.communicate()
            raise RuntimeError(f"command timed out: {command[0]}") from None
    if check and process.returncode:
        raise RuntimeError(f"{' '.join(map(str, command[:4]))}: {stderr.strip() or stdout.strip() or 'failed'}")
    return process.returncode, stdout.strip(), stderr.strip()


def check_path(path, directory=False, optional=False):
    if path.is_symlink():
        raise RuntimeError(f"refusing symlink: {path}")
    if optional and not path.exists():
        return
    if not (path.is_dir() if directory else path.is_file()):
        raise RuntimeError(f"missing or wrong file type: {path}")
    mode = path.stat().st_mode
    if not mode & 0o444 or not os.access(path, os.R_OK) or (
            directory and (not mode & 0o111 or not os.access(path, os.X_OK))):
        raise RuntimeError(f"unreadable: {path}")
    if directory:
        for child in path.iterdir():
            check_path(child, directory=child.is_dir())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--install-only", action="store_true", help="stage files without applying the layout")
    args = parser.parse_args()
    os.umask(0o077)
    repo = Path(__file__).resolve().parents[1]
    home = Path.home()
    data = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share")
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state") / "arasaka-kde"
    runtime = home / ".local/libexec/arasaka-kde"
    package = data / "plasma/plasmoids" / PLUGIN
    source = repo / "plasma/applets" / PLUGIN
    pending_file = state / "launcher-restart.json"
    runtime_sources = {
        "reconcile-displays": repo / "bin/reconcile-displays",
        "arasaka_topology.py": repo / "lib/arasaka_topology.py",
        "layout.js": repo / "plasma/layout.js",
        "shader-wallpaper.js": repo / "plasma/shader-wallpaper.js",
        "wallpaper-defaults.json": repo / "plasma/wallpaper-defaults.json",
        "Arasaka.json": repo / "theme/panel-colorizer/Arasaka.json",
    }
    for tool in ("kpackagetool6", "qdbus6", "systemctl", "kscreen-doctor", "bash",
                 "python3", "dirname", "mkdir", "flock", "jq", "sha256sum", "cut", "sleep"):
        if not shutil.which(tool):
            raise RuntimeError(f"required command not found: {tool}")
    for root in (data, config, state, runtime, package):
        if not root.is_absolute():
            raise RuntimeError(f"expected absolute path: {root}")
        for parent in (root, *root.parents):
            if parent.is_symlink():
                raise RuntimeError(f"refusing symlink: {parent}")
    check_path(source, directory=True)
    check_path(source / "contents/ui/main.qml")
    check_path(source / "metadata.json")
    metadata = json.loads((source / "metadata.json").read_text())
    if metadata.get("KPackageStructure") != "Plasma/Applet" or metadata.get("KPlugin", {}).get("Id") != PLUGIN:
        raise RuntimeError(f"invalid launcher metadata: {source}")
    for path in runtime_sources.values():
        check_path(path)
    configs = [config / "plasma-org.kde.plasma.desktop-appletsrc", config / "plasmashellrc"]
    for path in configs + [pending_file]:
        check_path(path, optional=True)
    check_path(runtime, directory=True, optional=True)
    check_path(package, directory=True, optional=True)
    # Package validation and the live session probe must precede any state writes.
    run("kpackagetool6", "--type", "Plasma/Applet", "--show", str(source))
    run(*PLASMA, "org.freedesktop.DBus.Peer.Ping")
    owner = run("qdbus6", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                "org.freedesktop.DBus.GetNameOwner", "org.kde.plasmashell")[1]
    if not owner.startswith(":"):
        raise RuntimeError("could not identify the live Plasma session")
    bus_id = run("qdbus6", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                 "org.freedesktop.DBus.GetId")[1]
    if not bus_id:
        raise RuntimeError("could not identify the session bus")
    owner = f"{bus_id}/{owner}"
    status_script = STATUS_SCRIPT.replace("__LAUNCHER_SESSION__", json.dumps(owner))
    pending = json.loads(pending_file.read_text()) if pending_file.exists() else None
    if pending and pending["owner"] == owner:
        raise RuntimeError("launcher files are staged; restart Plasma explicitly (or log out/in), then rerun "
                           "apply-launcher. The display watcher remains paused; no layout was applied.")
    status = json.loads(run(*PLASMA, "org.kde.PlasmaShell.evaluateScript", status_script)[1])
    source_files = {p.relative_to(source): p.read_bytes() for p in source.rglob("*") if p.is_file()}
    installed_files = {p.relative_to(package): p.read_bytes() for p in package.rglob("*") if p.is_file()}
    restart_needed = bool(status["hosts"] and source_files != installed_files)
    path_loaded = run("systemctl", "--user", "show", "--property=LoadState", "--value", PATH_UNIT)[1] != "not-found"
    service_loaded = run("systemctl", "--user", "show", "--property=LoadState", "--value", SERVICE_UNIT)[1] != "not-found"
    active = False
    if path_loaded:
        code = run("systemctl", "--user", "is-active", "--quiet", PATH_UNIT, check=False)[0]
        if code not in (0, 3):
            raise RuntimeError("could not determine display watcher state")
        active = code == 0
    resume = active or bool(pending and pending["resume_path"])
    backups = state / "backups"
    if backups.is_symlink():
        raise RuntimeError(f"refusing symlink: {backups}")
    backups.mkdir(parents=True, exist_ok=True)
    backup = Path(tempfile.mkdtemp(prefix="launcher-", dir=backups))
    print(f"Launcher backup: {backup}", flush=True)
    paused = False
    keep_paused = bool(pending)
    try:
        if active:
            run("systemctl", "--user", "stop", PATH_UNIT)
            paused = True
        if service_loaded:
            run("systemctl", "--user", "stop", SERVICE_UNIT)
        for path in configs:
            if path.exists():
                shutil.copy2(path, backup / path.name)
        if runtime.exists():
            shutil.copytree(runtime, backup / "runtime")
        if package.exists():
            shutil.copytree(package, backup / "package")
        for path in backup.rglob("*"):
            path.chmod(stat.S_IMODE(path.stat().st_mode) & 0o700)
        if restart_needed:
            # A persisted barrier prevents an identical rerun from trusting cached QML.
            pending_file.write_text(json.dumps({"owner": owner, "resume_path": resume}) + "\n")
            keep_paused = True
        package.parent.mkdir(parents=True, exist_ok=True)
        if source_files != installed_files:
            if package.exists():
                shutil.rmtree(package)
            shutil.copytree(source, package)
        runtime.mkdir(parents=True, exist_ok=True)
        for name, path in runtime_sources.items():
            shutil.copy2(path, runtime / name)
            (runtime / name).chmod(0o755 if name == "reconcile-displays" else 0o644)
        if restart_needed:
            raise RuntimeError("launcher files installed, but the existing host still has cached QML. "
                               "Restart Plasma explicitly (or log out/in), then rerun apply-launcher. "
                               "No layout was applied; existing bars were retained and the display watcher is paused.")
        if args.install_only:
            print("Launcher files staged; layout not applied.")
            return
        deadline = time.monotonic() + 10
        failure = "launcher is not ready"
        while time.monotonic() < deadline:
            try:
                run(str(runtime / "reconcile-displays"), "--force", timeout=max(0.01, deadline - time.monotonic()))
                status = json.loads(run(*PLASMA, "org.kde.PlasmaShell.evaluateScript", status_script,
                                        timeout=max(0.01, deadline - time.monotonic()))[1])
                if status["ready"] and status["managedPanels"] == 0:
                    pending_file.unlink(missing_ok=True)
                    keep_paused = False
                    print("Launcher ready; managed bars removed. Press Super for the native menu and tray.")
                    break
                raise RuntimeError("launcher is not ready or managed panels remain")
            except (RuntimeError, ValueError) as error:
                if str(error) != failure:
                    print(f"Waiting for launcher convergence: {error}", file=sys.stderr)
                failure = str(error)
            time.sleep(min(0.5, max(0, deadline - time.monotonic())))
        else:
            raise RuntimeError(f"launcher convergence failed after 10 seconds: {failure}; backup: {backup}")
    finally:
        if resume and (paused or pending) and not keep_paused:
            run("systemctl", "--user", "start", PATH_UNIT)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, KeyError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
