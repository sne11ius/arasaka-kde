#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -f $script_dir/arasaka_topology.py ]]; then
  engine=$script_dir/arasaka_topology.py
  layout=$script_dir/layout.js
  shader_layout=$script_dir/shader-wallpaper.js
  shader_defaults=$script_dir/wallpaper-defaults.json
  colorizer_settings=$script_dir/Arasaka.json
else
  repo_root=$(cd -- "$script_dir/.." && pwd)
  engine=$repo_root/lib/arasaka_topology.py
  layout=$repo_root/plasma/layout.js
  shader_layout=$repo_root/plasma/shader-wallpaper.js
  shader_defaults=$repo_root/plasma/wallpaper-defaults.json
  colorizer_settings=$repo_root/theme/panel-colorizer/Arasaka.json
fi
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/arasaka-kde
state_file=$state_dir/topology
force=false
dry_run=false
hide_desktop_icons=false
ensure_shader_wallpaper=false
json_file=
while (($#)); do
  case $1 in
    --force)
      force=true
      ;;
    --dry-run)
      dry_run=true
      ;;
    --hide-desktop-icons)
      hide_desktop_icons=true
      ;;
    --ensure-shader-wallpaper)
      ensure_shader_wallpaper=true
      ;;
    --json)
      [[ $# -ge 2 ]] || { printf 'error: --json requires a file\n' >&2; exit 2; }
      json_file=$2
      shift
      ;;
    *)
      printf 'error: unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done
[[ -z $json_file ]] || $dry_run || { printf 'error: --json requires --dry-run\n' >&2; exit 2; }
mkdir -p "$state_dir"
exec 9>"$state_dir/reconcile.lock"
flock -n 9 || exit 0

if [[ -n $json_file ]]; then
  output_json=$(<"$json_file")
else
  output_json=$(kscreen-doctor --json 2>/dev/null)
fi

if $dry_run; then
  python3 "$engine" <<<"$output_json"
  exit 0
fi

plan_json=$(python3 "$engine" <<<"$output_json")
if [[ $(jq -r '.status // "ready"' <<<"$plan_json") == no-enabled-outputs ]]; then
  exit 0
fi

primary=$(jq -r '.primary' <<<"$plan_json")
internal=$(jq -r '.internal // ""' <<<"$plan_json")
signature=$(jq -r '.signature' <<<"$plan_json")
layout_version=$(sha256sum "$layout" "$colorizer_settings" | sha256sum | cut -d' ' -f1)
signature="$signature|$layout_version"

topology_changed=true
if [[ -f $state_file ]] && [[ $(<"$state_file") == "$signature" ]]; then
  topology_changed=false
fi

while IFS=$'\t' read -r connector priority; do
  [[ -n $connector ]] || continue
  kscreen-doctor "output.${connector}.priority.${priority}" >/dev/null
done < <(jq -r '.changes[] | @tsv' <<<"$plan_json")

if ! $force && ! $topology_changed && ! $hide_desktop_icons && ! $ensure_shader_wallpaper; then
  exit 0
fi

if $ensure_shader_wallpaper; then
  data_home=${XDG_DATA_HOME:-$HOME/.local/share}
  for asset in "$shader_layout" "$shader_defaults" \
    "$data_home/plasma/wallpapers/online.knowmad.shaderwallpaper/contents/ui/shaderwallpaper/libshaderwallpaperplugin.so" \
    "$data_home/wallpapers/Arasaka/shaders/Heartfelt_No_Heart.frag" \
    "$data_home/wallpapers/Arasaka/shaders/Interactive_Rain.frag" \
    "$data_home/wallpapers/Arasaka/mikoshi-16x9.png" \
    "$data_home/wallpapers/Arasaka/mikoshi-16x10.png"; do
    if [[ ! -r $asset || ! -s $asset ]]; then
      # Launcher-only updates publish this runtime without installing wallpapers. Keep
      # topology/layout usable during that upgrade (or a failed full-theme build), but
      # never assign an unavailable effect. The watcher rechecks readiness on every run.
      printf 'warning: shader wallpaper setup deferred; required asset missing: %s\n' "$asset" >&2
      ensure_shader_wallpaper=false
      break
    fi
  done
fi

for _ in {1..20}; do
  if qdbus6 org.kde.plasmashell /PlasmaShell org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done
qdbus6 org.kde.plasmashell /PlasmaShell org.freedesktop.DBus.Peer.Ping >/dev/null

bus_id=$(qdbus6 org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetId)
shell_owner=$(qdbus6 org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner org.kde.plasmashell)
[[ -n $bus_id && $shell_owner == :* ]] || { printf 'error: could not identify the live Plasma session\n' >&2; exit 1; }

colorizer=$(jq -c . "$colorizer_settings")
script=$(<"$layout")
script=${script//__LAUNCHER_SESSION__/$bus_id\/$shell_owner}
script=${script//__HIDE_DESKTOP_ICONS__/$hide_desktop_icons}
script=${script//__PRIMARY_CONNECTOR__/$primary}
script=${script//__INTERNAL_CONNECTOR__/$internal}
script=${script/__COLORIZER_SETTINGS__/$colorizer}

if $ensure_shader_wallpaper; then
  # Desktops can appear after the output configuration was saved. Check every
  # enabled connector on each event, even when the topology signature is unchanged.
  shader_script=$(<"$shader_layout")
  shader_script=${shader_script/__WALLPAPER_DEFAULTS_JSON__/"$(jq -c . "$shader_defaults")"}
  shader_script=${shader_script/__DATA_HOME_JSON__/"$(jq -cn --arg value "$data_home" '$value')"}
  shader_script=${shader_script/__PRIMARY_CONNECTOR_JSON__/"$(jq -cn --arg value "$primary" '$value')"}
  shader_script=${shader_script/__ENABLED_CONNECTORS_JSON__/"$(jq -c '.signature | fromjson | .enabled' <<<"$plan_json")"}
  shader_script=${shader_script/__ENSURE_ONLY__/true}
  # Commit the deferred wallpaper switch before a fresh wrapper can enable hover.
  # Each phase pairs icon policy with coverage checks, including newly appeared desktops.
  for phase in prepare activate; do
    expected_status=prepared
    [[ $phase == prepare ]] || expected_status=ok
    report=$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
      "$script"$'\n'"${shader_script/__SHADER_PHASE__/$phase}")
    [[ $report == ARASAKA_SHADER_WALLPAPER=* ]] &&
      jq -e --arg status "$expected_status" '.status == $status and (.desktops | length > 0) and
        all(.desktops[]; .wallpaperPlugin == "online.knowmad.shaderwallpaper")' \
        <<<"${report#ARASAKA_SHADER_WALLPAPER=}" >/dev/null || {
          printf 'error: shader wallpaper verification failed: %s\n' "$report" >&2
          exit 1
        }
  done
else
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script"
fi
printf '%s\n' "$signature" > "$state_file"
