#!/usr/bin/env python3
"""Build and deploy the pinned, user-local wallpaper without changing shell layout."""

import argparse
from datetime import datetime
import filecmp
import json
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import tarfile
import tempfile
from urllib.parse import unquote, urlsplit


PLUGIN = "online.knowmad.shaderwallpaper"
SHADER = "Heartfelt_No_Heart.frag"
MARKER = "ARASAKA_SHADER_WALLPAPER="


def check_path(path, directory=False):
    if not path.is_absolute() or ".." in path.parts:
        raise ValueError(f"expected an absolute path without '..': {path}")
    for part in (path, *path.parents):
        if part.is_symlink():
            raise ValueError(f"refusing symlink: {part}")
        if part != path and part.exists() and not part.is_dir():
            raise ValueError(f"not a directory: {part}")
    if path.exists() and not (path.is_dir() if directory else path.is_file()):
        raise ValueError(f"unexpected file type: {path}")


def run(*command, capture=False, input=None):
    result = subprocess.run(command, check=True, text=True, input=input,
                            stdout=subprocess.PIPE if capture else None)
    return result.stdout.strip() if capture else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--install-only", action="store_true", help="install and back up; no session calls")
    args = parser.parse_args()
    repo = Path(__file__).resolve().parents[1]
    home = Path(os.environ["HOME"])
    data = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share")
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state") / "arasaka-kde"
    backups = state / "backups"
    package_target = data / "plasma/wallpapers" / PLUGIN
    artwork = data / "wallpapers/Arasaka"
    jobs = os.environ.get("ARASAKA_SHADER_BUILD_JOBS", "4")
    if not jobs.isdecimal() or int(jobs) < 1:
        raise ValueError("ARASAKA_SHADER_BUILD_JOBS must be a positive integer")
    for tool in ["cmake", "rsvg-convert", "patch", "python3"] + ([] if args.install_only else ["qdbus6", "kscreen-doctor"]):
        if not shutil.which(tool):
            raise ValueError(f"required command not found: {tool}")

    # Validate every replacement and backup source before any live writes.
    images = [("mikoshi-16x9", 1920, 1080), ("mikoshi-16x10", 1600, 1000)]
    sources = [(package_target, Path("package"), True)]
    sources += [(artwork / f"{name}.png", Path("artwork") / f"{name}.png", False) for name, _, _ in images]
    sources += [(artwork / "shaders" / SHADER, Path("artwork/shaders") / SHADER, False)]
    sources += [(config / name, Path(name), False) for name in ("plasma-org.kde.plasma.desktop-appletsrc", "plasmashellrc")]
    sources += [(home / ".local/libexec/arasaka-kde/layout.js", Path("runtime/layout.js"), False)]
    check_path(backups, directory=True)
    for source, _, directory in sources:
        check_path(source, directory)
        if directory and source.exists():
            for child in source.rglob("*"):
                check_path(child, child.is_dir())
    patch = repo / "assets/wallpapers/shaders/heartfelt-no-heart.patch"
    dusti_patch = repo / "assets/wallpapers/shaders/dusti.patch"
    inputs = [patch, dusti_patch, repo / "plasma/shader-wallpaper.js", repo / "lib/arasaka_topology.py"]
    inputs += [repo / "assets/wallpapers" / f"{name}.svg" for name, _, _ in images]
    for path in inputs:
        if not path.is_file() or not os.access(path, os.R_OK):
            raise ValueError(f"required readable input not found: {path}")

    archive = run(str(repo / "bin/fetch-components"), "shader-wallpaper", capture=True)
    tokyo = Path(run(str(repo / "bin/fetch-components"), "shader-tokyo", capture=True)).read_bytes().decode("utf-8-sig")
    dusti = json.loads(Path(run(str(repo / "bin/fetch-components"), "shader-dusti", capture=True)).read_bytes())["Shader"]
    passes = dusti.get("renderpass", [])
    if (dusti.get("info", {}).get("id") != "tcXXDB" or len(passes) != 1
            or passes[0].get("type") != "image" or passes[0].get("name") != "Image" or passes[0].get("inputs") != []):
        raise ValueError("Dusti must be tcXXDB with a single Image pass and no inputs")
    dusti_code = passes[0].get("code", "")
    if not isinstance(dusti_code, str) or "mainImage" not in dusti_code or "mainImage" not in tokyo:
        raise ValueError("selectable shader source is missing its mainImage entry point")
    with tempfile.TemporaryDirectory(prefix="arasaka-shader-wallpaper-") as temporary:
        stage = Path(temporary)
        source_root = stage / "source"
        source_root.mkdir()
        with tarfile.open(archive, "r:gz") as tar:
            if any(not (member.isfile() or member.isdir()) for member in tar.getmembers()):
                raise ValueError("source archive contains links or special files")
            tar.extractall(source_root, filter="data")
        roots = list(source_root.iterdir())
        if len(roots) != 1 or not (roots[0] / "CMakeLists.txt").is_file():
            raise ValueError("source archive must contain one CMake project")
        source = roots[0]
        build = stage / "build"
        run("cmake", "-S", str(source), "-B", str(build), "-DCMAKE_BUILD_TYPE=Release",
            f"-DCMAKE_INSTALL_PREFIX={stage / 'prefix'}")
        # Upstream builds into source/package. Never run build.sh or cmake --install.
        run("cmake", "--build", str(build), "--parallel", jobs)
        package = source / "package"
        metadata = json.loads((package / "metadata.json").read_text())
        if metadata.get("KPackageStructure") != "Plasma/Wallpaper" or metadata.get("KPlugin", {}).get("Id") != PLUGIN:
            raise ValueError("unexpected wallpaper package metadata")
        ui = package / "contents/ui"
        native = ui / "shaderwallpaper"
        required = [package / "contents/config/main.xml", ui / "main.qml", ui / "Shaders/Heartfelt.frag",
                    native / "libshaderwallpaperplugin.so", native / "qmldir", native / "PluginStatus.qml"]
        for path in required:
            if not path.is_file() or path.stat().st_size == 0:
                raise ValueError(f"missing staged artifact: {path}")
        with (native / "libshaderwallpaperplugin.so").open("rb") as library:
            if library.read(4) != b"\x7fELF":
                raise ValueError("staged libshaderwallpaperplugin.so is not an ELF library")
        if "plugin shaderwallpaperplugin" not in (native / "qmldir").read_text():
            raise ValueError("staged qmldir does not load the embedded plugin")
        if not re.search(r"\binstalled\s*:\s*true\b", (native / "PluginStatus.qml").read_text()):
            raise ValueError("staged PluginStatus.qml still reports the native plugin as missing")
        shutil.copy2(source / "LICENSE", package / "LICENSE")
        for child in package.rglob("*"):
            check_path(child, child.is_dir())

        shaders = stage / "shaders"
        shaders.mkdir()
        shutil.copy2(ui / "Shaders/Heartfelt.frag", shaders / SHADER)
        run("patch", "--batch", "--forward", "--fuzz=0", "-p1", "-d", str(shaders), "-i", str(patch))
        adapted = (shaders / SHADER).read_text()
        original = (ui / "Shaders/Heartfelt.frag").read_text()
        if re.search(r"^\s*#\s*define\s+HAS_HEART\b", adapted, re.MULTILINE):
            raise ValueError("adapted shader still enables HAS_HEART")
        if "mainImage" not in adapted or any(line not in adapted for line in original.splitlines()[:3]):
            raise ValueError("adapted shader lost its entry point or upstream license header")

        dusti_path = ui / "Shaders/Dusti.frag"
        dusti_path.write_text(dusti_code, encoding="utf-8")
        run("patch", "--batch", "--forward", "--fuzz=0", "-p1", "-d", str(dusti_path.parent), "-i", str(dusti_patch))
        dusti_code = dusti_path.read_text(encoding="utf-8")

        index_path = ui / "shader_index.json"
        index = json.loads(index_path.read_text())
        gallery = [
            {"id": "shadertoy-Xtf3zn", "name": "Tokyo", "author": "Reinder Nijhoff (reinder)",
             "sourceId": "Xtf3zn", "shaderPath": "Shaders/Tokyo.frag", "category": "Raymarching",
             "license": "CC BY-NC-SA 4.0", "needsTextures": False,
             "description": "Tokyo by night in the rain. CC BY-NC-SA 4.0; author's pinned source, original letterboxing. "
                            "Credits Eiffie (car), Dave Hoskins (rain), and iq (smin)."},
            {"id": "shadertoy-tcXXDB", "name": "Dusti [237 Chars]", "author": "HellMood",
             "sourceId": "tcXXDB", "shaderPath": "Shaders/Dusti.frag", "category": "Raymarching",
             "license": "CC BY-NC-SA 3.0", "needsTextures": False,
             "description": "Depth and desert colors. Shadertoy default CC BY-NC-SA 3.0 applies to the archived snapshot; "
                            "current live licensing is unverified. Credits Xor, FabriceNeyret2, gopher, and catnip. "
                            "Arasaka opaque-alpha adapter (O.a = 1.0); RGB unchanged. "
                            "Upstream uninitialized locals retained as a portability risk."},
            {"id": "arasaka-heartfelt-no-heart", "name": "Heartfelt No Heart", "author": "Martijn Steinrucken (BigWings)",
             "sourceId": "ltffzl", "shaderPath": (artwork / "shaders" / SHADER).as_uri(), "category": "Nature",
             "license": "CC BY-NC-SA 3.0", "needsTextures": True,
             "description": "Arasaka's no-heart adaptation of Heartfelt (2017). CC BY-NC-SA 3.0; "
                            "rain over the Arasaka artwork in texture channel 0. Credits Dave Hoskins."},
        ]
        for entry, code in zip(gallery, (tokyo, dusti_code)):
            # Routing is explicit so selecting an input-free shader cannot inherit the artwork channel.
            header = (f"// {entry['name']} - {entry['author']}\n"
                      f"// {entry['description']}\n"
                      f"// Source: https://www.shadertoy.com/view/{entry['sourceId']}\n"
                      "// Arasaka import: explicit channel routing; compatibility changes described above.\n"
                      "// @channels none,none,none,none\n\n")
            (ui / entry["shaderPath"]).write_text(header + code, encoding="utf-8")
        for entry in gallery:
            entry.update(source="shadertoy", needsAudio=False, hasBuffers=False, favorite=False,
                         tags=["arasaka"], thumbnailPath="", likes=0, views=0)
        index["shaders"].extend(gallery)
        old_ui = package_target / "contents/ui"
        managed_paths = {entry["shaderPath"] for entry in gallery}
        # Imports can include whole bundles, buffers, textures, and unindexed files.
        for folder in ("Shaders", "Shaders6"):
            old_folder = old_ui / folder
            if not old_folder.exists():
                continue
            for path in (old_folder, *old_folder.rglob("*")):
                relative = path.relative_to(old_ui)
                target = ui / relative
                if path.is_file() and str(relative) in managed_paths:
                    continue
                if target.exists():
                    if path.is_dir() and target.is_dir():
                        continue
                    if path.is_file() and target.is_file() and filecmp.cmp(path, target, shallow=False):
                        continue
                    raise ValueError(f"shader file collision; preserve or rename the custom file before retrying: {path}")
                if path.is_dir():
                    target.mkdir(parents=True, exist_ok=True)
                else:
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(path, target)

        def shader_key(value):
            url = urlsplit(value)
            if url.scheme == "file" and url.netloc in ("", "localhost"):
                value = unquote(url.path)
            elif url.scheme:
                return value
            return os.path.normpath(old_ui / value)

        old_index = old_ui / "shader_index.json"
        if old_index.is_file():
            saved = json.loads(old_index.read_text(encoding="utf-8"))
            by_path = {shader_key(entry["shaderPath"]): entry for entry in index["shaders"]}
            for entry in saved["shaders"]:
                key = shader_key(entry["shaderPath"])
                if key in by_path:
                    # Keep gallery identity/favorites, not obsolete managed source metadata.
                    by_path[key].update({field: entry[field] for field in ("id", "favorite", "thumbnailPath") if field in entry})
                else:
                    index["shaders"].append(entry)
                    by_path[key] = entry
            for category in saved.get("categories", []):
                if category not in index["categories"]:
                    index["categories"].append(category)
            ids = [entry["id"] for entry in index["shaders"]]
            if len(set(ids)) != len(ids):
                raise ValueError("gallery ID collision; resolve duplicate shader identities before retrying")
        index_path.write_text(json.dumps(index, indent=2) + "\n", encoding="utf-8")

        replacements = [(package, package_target), (shaders / SHADER, artwork / "shaders" / SHADER)]
        for name, width, height in images:
            png = stage / f"{name}.png"
            run("rsvg-convert", "--width", str(width), "--height", str(height), "--output", str(png),
                str(repo / "assets/wallpapers" / f"{name}.svg"))
            header = png.read_bytes()[:24]
            if len(header) != 24 or header[:8] != b"\x89PNG\r\n\x1a\n" or struct.unpack(">II", header[16:24]) != (width, height):
                raise ValueError(f"invalid staged artwork: {png}")
            replacements.append((png, artwork / png.name))

        if not args.install_only:
            topology = run("kscreen-doctor", "--json", capture=True)
            plan = json.loads(run("python3", str(repo / "lib/arasaka_topology.py"), input=topology, capture=True))
            if not plan.get("primary"):
                raise ValueError("no primary connector in current display topology")
            values = {"DATA_HOME": str(data), "PRIMARY_CONNECTOR": plan["primary"],
                      "ENABLED_CONNECTORS": json.loads(plan["signature"])["enabled"]}
            script = re.sub(r"__(DATA_HOME|PRIMARY_CONNECTOR|ENABLED_CONNECTORS)_JSON__", lambda match: json.dumps(values[match[1]]),
                            (repo / "plasma/shader-wallpaper.js").read_text())

        # Back up all sources before replacing any of them, including existing runtime policy.
        for path, _, directory in sources:
            check_path(path, directory)
        backups.mkdir(parents=True, exist_ok=True)
        backup = Path(tempfile.mkdtemp(prefix=f"shader-wallpaper-{datetime.now():%Y%m%d-%H%M%S}-", dir=backups))
        print(f"Shader wallpaper backup: {backup}", file=sys.stderr)
        for path, relative, directory in sources:
            if path.exists():
                target = backup / relative
                target.parent.mkdir(parents=True, exist_ok=True)
                if directory:
                    shutil.copytree(path, target)
                else:
                    shutil.copy2(path, target)
        for path, target in replacements:
            target.parent.mkdir(parents=True, exist_ok=True)
            # Finish copying on the target filesystem before removing an existing package.
            with tempfile.TemporaryDirectory(prefix=".arasaka-shader-", dir=target.parent) as incoming:
                ready = Path(incoming) / target.name
                if path.is_dir():
                    shutil.copytree(path, ready)
                    if target.exists():
                        shutil.rmtree(target)
                else:
                    shutil.copy2(path, ready)
                os.replace(ready, target)
        if args.install_only:
            print("Shader wallpaper installed; no live session calls were made.", file=sys.stderr)
            return
        try:
            output = run("qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript",
                         script, capture=True)
            reports = [line[len(MARKER):] for line in output.splitlines() if line.startswith(MARKER)]
            report = json.loads(reports[0]) if len(reports) == 1 else {}
            if not isinstance(report, dict):
                raise ValueError(f"invalid verification report: {output}")
            desktops = report.get("desktops", [])
            if (report.get("status") != "ok" or not desktops
                    or len({d["id"] for d in desktops}) != len(desktops)
                    or any(type(d["screen"]) is not int or d["screen"] < 0 for d in desktops)
                    or report.get("primaryScreen") not in {d["screen"] for d in desktops}):
                raise ValueError(f"invalid desktop verification result: {output}")
            for desktop in desktops:
                settings = desktop["config"]
                image = "mikoshi-16x9.png" if desktop["screen"] == report["primaryScreen"] else "mikoshi-16x10.png"
                expected = {
                    "selectedShaderPath": (artwork / "shaders" / SHADER).as_uri(), "selectedShaderCode": "",
                    "iChannel0": (artwork / image).as_uri(), "iChannel0Enabled": True, "imageChannel0": 0,
                    "running": True, "shaderSpeed": 0.75, "targetFps": 30, "resolutionScale": 1,
                    "pauseMode": 0, "checkActiveScreen": True, "excludeWindows": [],
                    "mouseEnabled": False, "audioEnabled": False, "windowsEnabled": False,
                    "playlistEnabled": False, "enableShaderTweaks": False, "commonCode": "",
                    "useBufferA": False, "useBufferB": False, "useBufferC": False, "useBufferD": False,
                    "iChannel1Enabled": False, "iChannel2Enabled": False, "iChannel3Enabled": False,
                    "imageChannel1": -1, "imageChannel2": -1, "imageChannel3": -1,
                }
                if (desktop["wallpaperPlugin"] != PLUGIN or not isinstance(settings, dict)
                        or any(settings.get(key) != value for key, value in expected.items())):
                    raise ValueError(f"unexpected wallpaper verification result: {output}")
        except (subprocess.CalledProcessError, ValueError, KeyError, TypeError) as error:
            raise ValueError(f"wallpaper activation verification failed: {error}; backup: {backup}. "
                             "If Plasma has not discovered the plugin, explicitly restart Plasma or log out/in, then rerun. "
                             "Plasma was not restarted automatically.") from error
        print(f"Verified wallpaper configuration on {len(desktops)} desktop(s) at 30 FPS; mouse/audio capture disabled.", file=sys.stderr)
        print("Configuration readback does not prove rendering. An already-loaded native plugin/QML may need an explicit "
              "Plasma restart after replacement; no automatic restart was performed.", file=sys.stderr)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError, tarfile.TarError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
