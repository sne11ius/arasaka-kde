#!/bin/sh
# Adapted from Debian SDDM's xdm-derived configuration script.
# Copyright 2000-2001 Branden Robinson.
# Licensed under the GNU General Public License, version 2. See
# /usr/share/common-licenses/GPL-2 or <https://www.gnu.org/licenses/>.
# Preparation only: no prompt, selection, or default-file manipulation.
set -e
. /usr/share/debconf/confmodule

db_fget shared/default-x-display-manager seen
saved_seen=$RET
db_register shared/default-x-display-manager shared/default-x-display-manager
db_metaget shared/default-x-display-manager owners
db_subst shared/default-x-display-manager choices "$RET"
db_fset shared/default-x-display-manager seen "$saved_seen"
db_set plasmalogin/daemon_name /usr/bin/plasmalogin
# Never SET the shared question: its existing value is authoritative here.

exit 0
