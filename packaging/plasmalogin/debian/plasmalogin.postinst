#!/bin/sh
set -e

if [ "$1" = configure ]; then
    . /usr/share/debconf/confmodule
    db_stop
    systemd-sysusers ${DPKG_ROOT:+--root="$DPKG_ROOT"} plasmalogin.conf
    systemd-tmpfiles ${DPKG_ROOT:+--root="$DPKG_ROOT"} --create plasmalogin.conf
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload
    fi
fi

#DEBHELPER#
exit 0
