+vec3 sampleBackground(vec2 uv, float focus)
+{
+    // Cubic B-spline reconstruction removes mip-grid corners; finer levels reduce fog slightly.
+    float level = max(focus - 1.0, 0.0);
+    vec3 result = vec3(0.0);
+    for (int k = 0; k < 2; ++k) {
+        float lod = floor(level) + float(k);
+        vec2 size = vec2(textureSize(iChannel0, int(lod)));
+        vec2 p = uv * size - 0.5;
+        vec2 f = fract(p);
+        p -= f;
+        vec2 f2 = f * f;
+        vec2 f3 = f2 * f;
+        vec2 w0 = (1.0 - 3.0*f + 3.0*f2 - f3) / 6.0;
+        vec2 w1 = (4.0 - 6.0*f2 + 3.0*f3) / 6.0;
+        vec2 w2 = (1.0 + 3.0*f + 3.0*f2 - 3.0*f3) / 6.0;
+        vec2 w3 = f3 / 6.0;
+        vec2 g0 = w0 + w1;
+        vec2 g1 = w2 + w3;
+        vec2 p0 = (p - 0.5 + w1/g0) / size;
+        vec2 p1 = (p + 1.5 + w3/g1) / size;
+        vec3 row0 = textureLod(iChannel0, p0, lod).rgb * g0.x
+                  + textureLod(iChannel0, vec2(p1.x, p0.y), lod).rgb * g1.x;
+        vec3 row1 = textureLod(iChannel0, vec2(p0.x, p1.y), lod).rgb * g0.x
+                  + textureLod(iChannel0, p1, lod).rgb * g1.x;
+        result += (row0*g0.y + row1*g1.y) * (k == 0 ? 1.0-fract(level) : fract(level));
+    }
+    return result;
+}
